APP_NAME=LajanAnsanm
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.lajanansanm.com
APP_FORCE_HTTPS=true
# APP_KEY : générez-la avec "php artisan key:generate --show" (ne réutilisez PAS celle de votre PC)

APP_LOCALE=ht
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lajanansanm
DB_USERNAME=lajan_user        # PAS "root"
DB_PASSWORD=UN-MOT-DE-PASSE-LONG-ET-UNIQUE

SESSION_DRIVER=database
SESSION_LIFETIME=2
SESSION_ABSOLUTE_LIFETIME=480
SESSION_SECURE_COOKIE=true    # cookies uniquement en HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# E-mails : SMTP Gmail avec STARTTLS; utiliser un mot de passe d'application Google
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=lajanansanm.ht@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="lajanansanm.ht@gmail.com"
MAIL_FROM_NAME="LajanAnsanm"

# Set the exact proxy IPs/CIDRs if TLS terminates at a reverse proxy; do not use *.
TRUSTED_PROXIES=
# Provide payment credentials through the deployment secret manager; never commit them.
MONCASHCONNECT_ENABLED=false
MONCASHCONNECT_SECRET_KEY=
MONCASHCONNECT_WEBHOOK_SECRET=
MONCASHCONNECT_ORIGIN=https://www.lajanansanm.com
MONCASHCONNECT_BASE_URL=https://api.moncashconnect.com/v1
MONCASHCONNECT_VERIFY_WITH_API=true
MONCASHCONNECT_MAX_AMOUNT=1000000
