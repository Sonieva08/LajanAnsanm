APP_NAME=LajanAnsanm
APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.lajanansanm.ht
# APP_KEY : générez-la avec "php artisan key:generate --show" (ne réutilisez PAS celle de votre PC)

APP_LOCALE=ht
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lajanansanm
DB_USERNAME=lajan_user        # PAS "root"
DB_PASSWORD=UN-MOT-DE-PASSE-LONG-ET-UNIQUE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # cookies uniquement en HTTPS
SESSION_SAME_SITE=lax

# E-mails (réinitialisation de mot de passe) : exemple SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.exemple.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="lajanansanm.ht@gmail.com"
MAIL_FROM_NAME="LajanAnsanm"

# Paiement des abonnements par MonCash (via MonCashConnect, service indépendant) — optionnel
MONCASHCONNECT_ENABLED=true
MONCASHCONNECT_SECRET_KEY=            # sk_test_proj_… (sandbox) puis sk_proj_… (live). Jamais dans le navigateur ni dans git.
MONCASHCONNECT_ORIGIN=https://www.lajanansanm.ht
MONCASHCONNECT_WEBHOOK_SECRET=        # « whsec_… » affiché dans Developer → Projets → Configurer le webhook
# URL à renseigner dans le dashboard MonCashConnect : https://www.lajanansanm.ht/webhooks/moncashconnect
